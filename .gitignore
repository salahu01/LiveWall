# SwiftPM build products (platforms/macos)
.build/
.swiftpm/
Package.resolved

# Assembled app bundle — produced by platforms/macos/tools/bundle.sh, never
# committed. A login item registered against a bundle here breaks on the next
# build; install to /Applications with tools/install.sh instead.
build/

# CMake build products (platforms/windows)
out/
CMakeUserPresets.json
*.vcxproj
*.vcxproj.filters
*.sln
.vs/

# Gradle build products (platforms/android). `local.properties` holds the path to
# whichever SDK this machine happens to have and is regenerated by tools/build.sh.
# `key.properties` holds a release keystore's passwords and must never be
# committed — keep the real one outside the repository.
.gradle/
local.properties
key.properties
*.apk
*.aab
*.keystore
*.jks

# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/

.DS_Store
Thumbs.db
