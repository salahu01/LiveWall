#include <windows.h>
#include "resource.h"

// The manifest is embedded here rather than generated by the linker
// (/MANIFEST:NO in CMakeLists.txt), because the linker's generated one cannot
// carry the per-monitor-v2 dpiAwareness element.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "LiveWall.manifest"

// Icons are optional at build time. tools/make-icon.ps1 draws them; without
// them the app falls back to a system icon and still runs, which keeps a fresh
// clone buildable.
//
// The presence check is done by CMake and passed in as a define, because the
// resource compiler is not a C preprocessor — it has no __has_include, and a
// missing file is a hard error rather than a skipped block.
#ifdef LIVEWALL_HAVE_APPICON
IDI_APPICON   ICON "AppIcon.ico"
#endif
#ifdef LIVEWALL_HAVE_TRAYICON
IDI_TRAYICON  ICON "TrayIcon.ico"
#endif

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     VER_FILEVERSION
    PRODUCTVERSION  VER_PRODUCTVERSION
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS       VS_FF_DEBUG
#else
    FILEFLAGS       0x0L
#endif
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Fegno Technologies"
            VALUE "FileDescription",  "LiveWall — low-power live wallpaper"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "LiveWall"
            VALUE "LegalCopyright",   "MIT licensed"
            VALUE "OriginalFilename", "LiveWall.exe"
            VALUE "ProductName",      "LiveWall"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
