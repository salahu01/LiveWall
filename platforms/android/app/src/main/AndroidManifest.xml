<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required, not optional: a device without live wallpaper support has
         nothing for this app to be. -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <!-- OpenGL ES 2.0 is the floor for the external-texture path; the context is
         created at 3.0 and falls back. -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.LiveWall"
        android:hardwareAccelerated="true">

        <service
            android:name=".app.LiveWallService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- Both the launcher entry and the wallpaper picker's "Settings" button
             land here. It has to survive being hosted inside the picker, which
             is why it never finishes itself on a result. -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
